# Example gradys-embedded runner configuration.
#
# Canonical example; fleet deployments render this from a template in
# gradys-fleet (roles/gradys_embedded/templates/embedded.toml.j2).
#
# Install to /etc/gradys/embedded.toml and run:
#     gradys-embedded --config /etc/gradys/embedded.toml

# --- Identity (differs per drone) --------------------------------------------

# Must be a key of [node_ip_dict] below. By fleet convention this equals the
# uav_api sysid and the flight controller's SYSID_THISMAV, though nothing in
# the software enforces that.
node_id = 1

# Cartesian NEU metres from origin_gps_coordinates. The z component doubles as
# the takeoff altitude. Two drones must never share an initial_position.
initial_position = [0.0, 0.0, 10.0]

# --- Local services ----------------------------------------------------------

# uav_api is always reached over plain HTTP on localhost at this port.
uav_api_port = 8000

# Control plane: POST /protocol/setup and /protocol/start land here.
control_api_port = 6000

# --- Protocol ----------------------------------------------------------------

# A DEFAULT SUGGESTION, not an autostart. The service boots idle and flies
# nothing until a mission is loaded over HTTP (POST /mission/load), so a drone
# that reboots in the field never spontaneously arms. Naming a protocol here only
# tells the legacy /protocol/setup endpoint which one to use.
protocol = "protocol:MyProtocol"

# --- Run data ----------------------------------------------------------------

# One subdirectory per mission, holding that run's statistics CSVs,
# resource_usage.csv, runner.log and RUN_INFO.json. Served by GET /runs and the
# download endpoints, so this must be writable and on persistent storage.
runs_dir = "~/gradys_runs"

# Where POST /protocols/upload writes, and what is added to sys.path so uploaded
# protocols can be imported by module name.
protocols_dir = "~/gradys_protocols"

# Refuse to open a new run below this many megabytes free. Nothing is ever
# auto-deleted -- losing an uncollected flight to a prune is worse than a
# refused start. Set 0 to disable.
min_free_disk_mb = 200

# --- Fleet-wide invariants ---------------------------------------------------
#
# These MUST be identical on every node. Nothing validates that at runtime, and
# a mismatch does not raise -- it silently desynchronizes the fleet.

# Leaving this unset makes each drone use its own boot GPS fix as the origin,
# which places every drone in a different coordinate frame. Always set it
# explicitly for a fleet.
origin_gps_coordinates = [-15.840081, -47.926642, 0.016]

# Clockwise rotation of the protocol x-axis from true north. 0.0 keeps the NEU
# convention (x=North, y=East).
x_axis_degrees = 0.0

# One of: http, https, http3, zenoh_tcp, zenoh_quic.
# http3 requires the [http3] extra; zenoh_* require the [zenoh] extra.
#
# A DEFAULT, not a fixed setting: POST /mission/load chooses the transport per
# run, and only the chosen one is ever served. The data plane binds nothing until
# a mission loads. zenoh_quic additionally needs a fleet-wide certfile/keyfile,
# identical on every drone, or load rejects it.
communication_protocol = "http"

# Seconds between telemetry polls.
telemetry_interval = 0.5

# --- Peer directory ----------------------------------------------------------
#
# Values are bare "host:port" with NO scheme. The transport builds
# "http://{addr}/message" itself, so a value containing http:// produces
# "http://http://..." and every send fails silently. The loader rejects this.
#
# Must be identical on every node.
[node_ip_dict]
1 = "10.0.2.11:5000"
2 = "10.0.2.12:5000"
3 = "10.0.2.13:5000"
